AWS_REGION=us-east-1
SES_FROM_EMAIL=verified-sender@example.com
SES_TO_EMAIL=your-inbox@example.com

# Read-only Bookwhen API token for bookwhen.com/bytebear. Without it the
# workshops section renders its empty state. Create one under
# Settings → Integrations → Bookwhen API, or at
# https://admin.bookwhen.com/settings/api_access_permission_sets
# Server-side only — never prefix this with NEXT_PUBLIC_.
BOOKWHEN_API_KEY=
